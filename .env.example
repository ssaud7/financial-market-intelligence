# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---- Kafka ---------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_QUOTES=market.quotes.raw
KAFKA_TOPIC_DLQ=market.quotes.dlq
KAFKA_CONSUMER_GROUP=fmis-bronze-loader

# ---- Paths (relative to repo root) ---------------------------------------
DATA_ROOT=data
LAKEHOUSE_ROOT=data/lakehouse
LANDING_ROOT=data/landing
QUARANTINE_ROOT=data/quarantine
VECTORSTORE_ROOT=data/vectorstore

# ---- Ingestion tuning ----------------------------------------------------
# Fraction of emitted payloads deliberately corrupted to exercise the data
# contract and the dead-letter path. Set to 0.0 for a clean run.
PRODUCER_CORRUPTION_RATE=0.08
PRODUCER_MAX_RECORDS=25000
# These 16 symbols are exactly the companies that ALSO have a 10-K in the filing
# corpus, so the lakehouse and the RAG index describe the same universe.
PRODUCER_TICKERS=MSFT,ORCL,ADBE,CRM,NOW,INTU,PLTR,CRWD,DDOG,FTNT,WDAY,ADSK,SNPS,CDNS,PAYC,TYL

# ---- RAG -----------------------------------------------------------------
# Generation runs on a local Ollama server (docker compose up -d ollama).
# No API key and no outbound calls: the whole RAG stage runs offline once the
# model and embeddings are pulled.
OLLAMA_HOST=http://localhost:11434
# ~4.7 GB, the quality/speed sweet spot on a 4-core Codespace (~3-6 tok/s).
# For faster iteration at lower answer quality, use llama3.2:3b-instruct-q4_K_M.
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_TIMEOUT_S=600
OLLAMA_TEMPERATURE=0.0
OLLAMA_SEED=7
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Chunk size is in characters; the embedding model caps at 512 tokens and
# ~1600 characters of filing prose stays comfortably under that.
RAG_CHUNK_CHARS=1600
RAG_CHUNK_OVERLAP_CHARS=250
# The Kaggle SEC corpus holds ~190 filings; the richest 25 are indexed by
# default. Raise it for more coverage at the cost of a longer embedding run,
# or set 0 to index everything.
RAG_FILING_LIMIT=25
# Indexed first regardless of length: the companies that also appear in
# PRODUCER_TICKERS, so one question can span prices and filings.
RAG_PREFERRED_COMPANIES=MICROSOFT,ORACLE,ADOBE,SALESFORCE,SERVICENOW,INTUIT,PALANTIR,CROWDSTRIKE,DATADOG,FORTINET,WORKDAY,AUTODESK,SYNOPSYS,CADENCE,PAYCOM,TYLER
RAG_DENSE_TOP_K=30
RAG_SPARSE_TOP_K=30
RAG_RRF_K=60
RAG_RERANK_TOP_N=6
RAG_MAX_ANSWER_TOKENS=4000

# ---- OpenLineage ---------------------------------------------------------
# "file" writes newline-delimited events to OPENLINEAGE_FILE (no server needed).
# "http" ships them to a Marquez instance (docker compose --profile lineage up).
OPENLINEAGE_TRANSPORT=file
OPENLINEAGE_FILE=evidence/lineage/openlineage-events.jsonl
OPENLINEAGE_URL=http://localhost:5000
OPENLINEAGE_NAMESPACE=financial-market-intelligence
