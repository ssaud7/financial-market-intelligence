# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---- Kafka ---------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_QUOTES=market.quotes.raw
KAFKA_TOPIC_DLQ=market.quotes.dlq
KAFKA_CONSUMER_GROUP=fmis-bronze-loader

# ---- Paths (relative to repo root) ---------------------------------------
DATA_ROOT=data
LAKEHOUSE_ROOT=data/lakehouse
LANDING_ROOT=data/landing
QUARANTINE_ROOT=data/quarantine
VECTORSTORE_ROOT=data/vectorstore

# ---- Ingestion tuning ----------------------------------------------------
# Fraction of emitted payloads deliberately corrupted to exercise the data
# contract and the dead-letter path. Set to 0.0 for a clean run.
PRODUCER_CORRUPTION_RATE=0.08
PRODUCER_MAX_RECORDS=25000
PRODUCER_TICKERS=AAPL,MSFT,NVDA,AMZN,GOOGL,META,JPM,XOM,UNH,PG

# ---- RAG -----------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-replace-me
RAG_GENERATION_MODEL=claude-sonnet-5
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_CHUNK_TOKENS=900
RAG_CHUNK_OVERLAP=150
RAG_DENSE_TOP_K=30
RAG_SPARSE_TOP_K=30
RAG_RRF_K=60
RAG_RERANK_TOP_N=6

# ---- OpenLineage ---------------------------------------------------------
# "file" writes newline-delimited events to OPENLINEAGE_FILE (no server needed).
# "http" ships them to a Marquez instance (docker compose --profile lineage up).
OPENLINEAGE_TRANSPORT=file
OPENLINEAGE_FILE=evidence/lineage/openlineage-events.jsonl
OPENLINEAGE_URL=http://localhost:5000
OPENLINEAGE_NAMESPACE=financial-market-intelligence
